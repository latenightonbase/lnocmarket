# Optional. Defaults to https://api.lnoc.app in production, localhost:3001 in dev.
API_ORIGIN=

# WalletConnect/Reown project ID for the wallet connect modal.
# Falls back to a demo ID if unset — fine for MetaMask/Coinbase/browser wallets,
# but WalletConnect-based mobile wallets won't work properly without a real one.
# Get one free at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
